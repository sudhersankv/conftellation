# Copy to .env.local and fill in. Never commit real values (this repo is public).

# FalkorDB: either FALKORDB_URL, or HOST/PORT/USERNAME/PASSWORD/TLS
# Local docker: FALKORDB_URL=falkor://localhost:6379
FALKORDB_URL=
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=true
FALKORDB_GRAPH=conftellations

# OpenAI (backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# true = deterministic hash embedder (auto when OPENAI_API_KEY is empty). Re-seed after switching.
EMBED_FAKE=

# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
BRIGHTDATA_SERP_ZONE=
# Scraper Studio collector ids (optional)
BRIGHTDATA_STUDIO_CATALOG_ID=
BRIGHTDATA_STUDIO_SESSION_ID=
# Hard cap on Bright Data requests per process run (credit guard)
BRIGHTDATA_MAX_REQUESTS=200
# Response cache dir (default seed/raw/cache). CACHE_ONLY=true never hits the network.
BRIGHTDATA_CACHE_DIR=
CACHE_ONLY=

# Serve precomputed brief/plan/trip report for the demo user
DEMO_MODE=true
# When true, API routes return fixtures from mocks/ instead of hitting the graph
USE_MOCKS=false
